<%- include('../partials/header') %>
<section class="section">
  <div class="container">
    <h1>Orders</h1>
    <div class="table">
      <div class="table-row header">
        <div>ID</div>
        <div>Total</div>
        <div>Status</div>
      </div>
      <% orders.forEach((order) => { %>
        <div class="table-row">
          <div>#<%= order.id %></div>
          <div>$<%= (order.total_cents / 100).toFixed(2) %></div>
          <div><%= order.status %></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
