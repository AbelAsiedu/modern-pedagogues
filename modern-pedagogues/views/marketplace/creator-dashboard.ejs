<%- include('../partials/header') %>
<section class="section">
  <div class="container">
    <div class="header-row">
      <h1>Creator Dashboard</h1>
      <a class="button" href="/marketplace/upload">Upload</a>
    </div>
    <% if (!items.length) { %>
      <p>No content yet.</p>
    <% } %>
    <% items.forEach((item) => { %>
      <div class="card">
        <h3><%= item.title %> <span class="pill"><%= item.status %></span></h3>
        <p>Downloads: <%= item.download_count %></p>
        <form method="POST" action="/marketplace/<%= item.id %>/publish" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="button" type="submit">Publish</button>
        </form>
      </div>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %>
